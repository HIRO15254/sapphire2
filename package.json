{
  "name": "sapphire2",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^18.0.9",
      "zod": "^4.6.7",
      "typescript": "^7.0.2",
      "@types/bun": "^1.4.4",
      "hono": "^4.13.16",
      "@trpc/server": "^11.24.0",
      "better-auth": "^1.7.18",
      "@better-auth/mcp": "1.7.18",
      "@better-auth/oauth-provider": "1.7.18",
      "@better-auth/passkey": "1.7.18",
      "@trpc/client": "^11.24.0",
      "drizzle-orm": "^0.45.4",
      "openai": "^7.52.0",
      "vitest": "5.1.0",
      "msw": "^3.0.4",
      "miniflare": "4.20260730.0"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "build": "bun run --filter '*' build",
    "check-types": "bun run --filter '*' check-types && tsc --noEmit -p scripts && tsc --noEmit -p testing",
    "dev:web": "bun run --filter web dev",
    "dev:server": "bun run --filter server dev",
    "db:studio": "bun run --filter @sapphire2/db db:studio",
    "db:generate": "bun run --filter @sapphire2/db db:generate",
    "db:migrate:local": "node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply sapphire2-db --local -c apps/server/wrangler.toml",
    "db:migrate:remote": "node ./node_modules/wrangler/bin/wrangler.js d1 migrations apply sapphire2-db --remote -c apps/server/wrangler.toml",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run --project=!api-integration",
    "test:integration": "vitest run --project api-integration",
    "test:e2e": "playwright test",
    "test:coverage": "bun run test:unit --coverage",
    "check:test-discovery": "bun testing/check-discovery.ts",
    "lint": "ultracite check",
    "check:rules": "bun scripts/check-rules.ts",
    "pr-watch": "bun scripts/pr-watch.ts",
    "try:ai-extract": "bun scripts/try-ai-extract.ts",
    "fix": "ultracite fix",
    "prepare": "husky"
  },
  "dependencies": {
    "@sapphire2/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.5",
    "@cloudflare/workers-types": "^5.20261106.1",
    "@playwright/test": "1.65.0",
    "@sapphire2/config": "workspace:*",
    "@types/bun": "catalog:",
    "@vitest/coverage-v8": "5.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "miniflare": "catalog:",
    "msw": "catalog:",
    "typescript": "catalog:",
    "ultracite": "8.1.1",
    "vitest": "catalog:",
    "wrangler": "^4.158.0",
    "yaml": "2.9.1"
  },
  "engines": {
    "node": "^22.22.2 || >=24.15.0",
    "bun": ">=1.4.0"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,jsonc,css,scss,md,mdx}": [
      "bun x ultracite fix"
    ]
  },
  "packageManager": "bun@1.4.4"
}
